# Python Cache & Byte-compiled files
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Environment Variables & Secrets
.env
.env.*
!.env.example
secrets.json

# Databases
*.sqlite3
db.sqlite3

# Media uploads & User Generated Content
**/media/
**/profile_pics/

# Static files collected for production
staticfiles/
static_root/

# Python packaging & builds
*.egg-info/
dist/
build/
eggs/
lib/
lib64/
parts/
sdist/
develop-eggs/
downloads/

# IDEs, Editors & OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Project Specific & Personal Notes
Note.md
notes.md
*.md.bak